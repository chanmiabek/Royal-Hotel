# Core
DEBUG=True
SECRET_KEY=changeme-in-render-use-a-generated-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
USE_DATABASE_URL_IN_DEBUG=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CONN_MAX_AGE=0

# Database
# Local development: leave empty to use SQLite.
# Production: set a PostgreSQL connection string.
DATABASE_URL=

# Media storage
# Render's filesystem is ephemeral. For production, prefer Cloudinary or another
# external media store instead of local disk uploads.
CLOUDINARY_URL=
USE_CLOUDINARY=False

# Email
DEFAULT_FROM_EMAIL=royal-hotel@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Payments
DEFAULT_CURRENCY=KES

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
# Sandbox: https://api-m.sandbox.paypal.com
# Live:    https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# M-Pesa
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:8000/payments/mpesa/callback/
MPESA_AUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
MPESA_STK_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_STK_QUERY_URL=https://sandbox.safaricom.co.ke/mpesa/stkpushquery/v1/query
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TRANSACTION_DESC=Hotel Booking Payment

# JWT / Neon Auth (optional)
JWT_ISSUER=
JWT_JWKS_URL=
JWT_AUDIENCE=
JWT_ALGORITHMS=RS256
JWT_LEEWAY_SECONDS=60

# Google Maps / OAuth
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Production notes for Render
# DEBUG=False
# CONN_MAX_AGE=60
# USE_CLOUDINARY=True
# ALLOWED_HOSTS=your-service.onrender.com,your-custom-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://your-custom-domain.com
# MPESA_CALLBACK_URL=https://your-service.onrender.com/payments/mpesa/callback/
